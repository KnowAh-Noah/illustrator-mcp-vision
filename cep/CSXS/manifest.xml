<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="12.0"
    ExtensionBundleId="com.aemcpvision.bridge"
    ExtensionBundleVersion="2.2.0"
    ExtensionBundleName="AE MCP Vision"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!--
    Two extensions in one bundle, deliberately:

      .server  headless, owns the Node HTTP server, auto-starts with AE.
      .panel   optional status/debug view. Closing it kills nothing.

    Splitting these means the MCP server does not depend on a human leaving a
    panel open. If <StartOn> turns out to be unreliable on AE (it is the least
    proven part of this design), the panel still exists as a manual boot path.
  -->

  <ExtensionList>
    <Extension Id="com.aemcpvision.bridge.server" Version="2.2.0" />
    <Extension Id="com.aemcpvision.bridge.panel"  Version="2.2.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- AE 22.0 floor: Layer.id / app.project.layerByID() land there, and
           stable layer identity is the basis of all addressing in v2. -->
      <Host Name="AEFT" Version="[22.0,99.9]" />
      <!-- Illustrator 27.0 (2023) floor: PageItem.uuid and
           Document.getPageItemFromUuid(), the basis of Illustrator addressing.
           Measured on 30.8.1; 27.x-29.x not yet verified. -->
      <Host Name="ILST" Version="[27.0,99.9]" />
    </HostList>
    <LocaleList><Locale Code="All" /></LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <!--
    One DispatchInfo per host. The ExtendScript host differs per app - each
    app's scripting DOM is unrelated to the other's, so each gets its own
    host.jsx - while the Node side is shared and reads the app from CEP at
    start-up (cep/server/app-profile.js).
  -->
  <DispatchInfoList>

    <Extension Id="com.aemcpvision.bridge.server">
      <DispatchInfo Host="AEFT">
        <Resources>
          <MainPath>./server.html</MainPath>
          <ScriptPath>./host/ae/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry><Size><Height>1</Height><Width>1</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
      <DispatchInfo Host="ILST">
        <Resources>
          <MainPath>./server.html</MainPath>
          <ScriptPath>./host/ai/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <!-- Measured on 30.8.1: the server starts when Illustrator first
                 becomes the active app, not at launch. Unknown event names are
                 ignored, so the candidates are all listed. -->
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
            <Event>com.adobe.csxs.events.ApplicationInitialized</Event>
            <Event>documentAfterActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry><Size><Height>1</Height><Width>1</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

    <Extension Id="com.aemcpvision.bridge.panel">
      <DispatchInfo Host="AEFT">
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/ae/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AE MCP Vision</Menu>
          <Geometry><Size><Height>320</Height><Width>420</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
      <DispatchInfo Host="ILST">
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/ai/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Illustrator MCP Vision</Menu>
          <Geometry><Size><Height>320</Height><Width>420</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

  </DispatchInfoList>
</ExtensionManifest>
